# Copia este archivo como deploy/ec2/.env y reemplaza todos los valores.
# Para evitar problemas en DATABASE_URL, usa una clave POSTGRES_PASSWORD
# alfanumerica larga (sin @, :, /, #, ? ni %).
POSTGRES_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_ALFANUMERICA_LARGA
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
ADMIN_EMAIL=admin@workdoc.local
ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_DE_AL_MENOS_12_CARACTERES
ADMIN_NAME=Administrador

# Puerto publico de la instancia EC2.
APP_PORT=3000

# false permite iniciar sesion mediante http://IP_PUBLICA:3000.
# Cambialo a true cuando publiques la aplicacion detras de HTTPS.
COOKIE_SECURE=false
